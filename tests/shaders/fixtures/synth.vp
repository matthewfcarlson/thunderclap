; A synthetic NV2A vertex program written for the tests (our own; not game data).
; Inputs: v0 position, v1 index (normalised byte = 2 * light), v2 normal, v3 uv.
; Constants: c96 = (0, 0.5, 256, 1); c100-c103 transform rows; c104 half vector; c105.x a scale, .w a power;
;            c106 specular colour; c110 + 2i light i direction, c111 + 2i light i colour (i = 0..3).
dp4 oPos.x, v0, c[100]
dp4 oPos.y, v0, c[101]
dp4 oPos.z, v0, c[102]
dp4 oPos.w, v0, c[103]
mul r0.x, v1.x, c[96].z              ; index * 256
arl a0.x, r0.x
dp3 r2.x, v2, -c[a0.x+110]           ; n . -L
dp3 r2.y, v2, c[104]                 ; n . H
mov r2.w, c[105].w                   ; specular power
lit r3, r2                           ; (1, diffuse, specular, 1); the ILU alone writes the named register
mul r4, r3.y, c[a0.x+111]
mad r4, r3.z, c[106], r4
sge r5.x, v3.x, c[96].y              ; 1 when u >= 0.5
dp3 r6.x, v2, v2 + rcp r1.y, c[105].x ; a pair: the ILU result goes to r1
mul r7.x, r6.x, r1.y
min oD0, r4, c[96].w
mul oT0, v3, r5.x
mov oFog.x, r7.x
mul oPos.xyz, r12, c[58] + rcc r1.x, r12.w
mad oPos.xyz, r12, r1.x, c[59]
